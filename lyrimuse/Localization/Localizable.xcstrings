          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เนื้อเพลงปัจจุบันแก้ไขหรือเลือกเอง ไม่ได้มาจากการเลือกอัตโนมัติด้านล่าง"
