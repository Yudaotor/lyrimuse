        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se exportaron dos archivos, ajustes y biblioteca de letras (%@). Copia ambos al pasar a un Mac nuevo"
          }
        },
        "fr" : {
          "stringUnit" : {
