    "✓ 当前可用，但仅在浏览器重启前有效：上述选项已关闭，重启后将失效" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✓ Funktioniert jetzt, aber nur bis zum Neustart des Browsers: Die Option oben wurde deaktiviert und wirkt nach einem Neustart nicht mehr"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✓ Works right now, but only until this browser restarts: the switch above has been turned off, so it will stop working after a restart"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✓ Funciona ahora, pero solo hasta que se reinicie este navegador: la opción de arriba está desactivada, así que dejará de funcionar al reiniciarlo"
