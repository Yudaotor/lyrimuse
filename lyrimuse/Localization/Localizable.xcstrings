          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แถวนับ %1$@ ครั้ง รายละเอียดรวม %2$@ ครั้ง"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У рядку: %1$@, у деталізації: %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hàng này tính %1$@ lượt, chi tiết cộng lại %2$@ lượt"
          }
        },
