          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold ⌘ and drag this icon to move it anywhere in the menu bar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén ⌘ y arrastra este icono para moverlo a cualquier lugar de la barra de menús"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ⌘ et faites glisser cette icône pour la placer n’importe où dans la barre des menus"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘キーを押しながらこのアイコンをドラッグすると、メニューバー内の好きな位置に移動できます"
