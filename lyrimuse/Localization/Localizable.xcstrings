          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Liedtext hat kein Timing. Übernommen erscheint er nur als statischer Text im Liedtextfenster und wird bei der Wiedergabe nicht Wort für Wort oder Zeile für Zeile hervorgehoben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These lyrics have no timing. Once adopted, they appear only as static text in the Lyrics Window and don’t highlight word by word or line by line during playback"
