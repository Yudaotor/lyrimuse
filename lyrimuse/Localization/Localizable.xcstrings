    "匹配条目" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgleich"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Match"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincidencia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspondance"
          }
        },
        "ja" : {
          "stringUnit" : {
