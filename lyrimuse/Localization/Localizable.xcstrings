    "尚未缓存任何歌词。播放歌曲后，Lyrimuse 会自动搜索并保存歌词" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Liedtexte zwischengespeichert. Wenn du einen Titel abspielst, sucht und sichert Lyrimuse den Liedtext automatisch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No lyrics cached yet. When you play a song, Lyrimuse finds and saves its lyrics automatically"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay letras en caché. Cuando reproduces una canción, Lyrimuse busca y guarda su letra automáticamente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune parole en cache. Quand vous écoutez un morceau, Lyrimuse trouve et enregistre ses paroles automatiquement"
          }
        },
        "it" : {
          "stringUnit" : {
