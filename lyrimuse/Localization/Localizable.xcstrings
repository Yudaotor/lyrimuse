        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative para manter precisa a posição de reprodução de %@ na reprodução automática, mostrar os botões de aleatório, repetir e favorito de %@ e controlar a reprodução sem o foco de mídia do sistema"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите это разрешение, чтобы точнее отслеживать позицию воспроизведения в %@ при автовоспроизведении, показать кнопки перемешивания, повтора и избранного для %@ и управлять воспроизведением без системного медиафокуса"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดสิทธิ์นี้เพื่อให้ตำแหน่งการเล่นของ %@ แม่นยำขึ้นเมื่อเล่นต่อเนื่องอัตโนมัติ และแสดงปุ่มสุ่ม เล่นซ้ำ และรายการโปรดของ %@ รวมถึงควบคุมการเล่นเมื่อไม่มีโฟกัส"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть цей дозвіл, щоб позиція відтворення під час автовідтворення була точнішою (%@), а також щоб показувати кнопки тасування, повтору й «До Улюблених» для %@ і керувати відтворенням без медіафокуса"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật quyền này để vị trí phát của %@ chính xác hơn khi tự động phát tiếp, đồng thời hiện nút Xáo trộn, Lặp lại và Ưa thích cho %@ và điều khiển phát khi mất tiêu điểm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请开启此权限，以提高%@自动连播时播放进度的准确性，并显示%@的随机、循环与喜欢按钮及失去焦点时的播放控制"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請開啟此權限，以提高%@自動連播時播放進度的準確性，並顯示%@的隨機、循環與喜歡按鈕及失去焦點時的播放控制"
          }
        }
      }
    },
    "未获得辅助功能权限，%@ 不显示随机、循环与喜欢按钮，失去焦点时也无法控制播放" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Bedienungshilfen-Berechtigung; die Tasten für Zufall, Wiederholen und Favorit von %@ sind ausgeblendet und die Wiedergabe lässt sich ohne Fokus nicht steuern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Accessibility permission; %@’s shuffle, repeat and Favorite buttons are hidden, and playback can’t be controlled while focus is elsewhere"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin permiso de accesibilidad; los botones de aleatorio, repetir y favorito de %@ están ocultos y la reproducción no se puede controlar sin el foco"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’autorisation Accessibilité ; les boutons Aléatoire, Répéter et Favori de %@ sont masqués et la lecture ne peut pas être contrôlée sans le focus"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun permesso Accessibilità: i pulsanti Casuale, Ripeti e Preferito di %@ sono nascosti e la riproduzione non si può controllare senza il focus"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティの権限がないため、%@ではシャッフル、リピート、お気に入りボタンが表示されず、フォーカスがないときは再生も制御できません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용 권한이 없어 %@에 임의 재생, 반복 및 즐겨찾기 버튼이 표시되지 않으며, 포커스를 잃었을 때 재생을 제어할 수 없습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem permissão de Acessibilidade; os botões de aleatório, repetir e favorito de %@ ficam ocultos e não é possível controlar a reprodução sem o foco"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет разрешения «Универсальный доступ»: кнопки перемешивания, повтора и избранного для %@ скрыты, а при потере фокуса управлять воспроизведением нельзя"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้รับสิทธิ์การช่วยการเข้าถึง %@ จึงไม่แสดงปุ่มสุ่ม เล่นซ้ำ และรายการโปรด และควบคุมการเล่นไม่ได้เมื่อไม่มีโฟกัส"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає дозволу «Доступність»: для %@ кнопки тасування, повтору й «До Улюблених» приховано, а без фокуса відтворенням не можна керувати"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
