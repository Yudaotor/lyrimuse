    "请确认已登录 Discord；如仍无法连接，请退出 Discord 后重新打开" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass du bei Discord angemeldet bist. Klappt es dann noch nicht, beende Discord und öffne es erneut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure you’re signed in to Discord. If it still won’t connect, quit Discord and open it again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de haber iniciado sesión en Discord. Si sigue sin conectarse, sal de Discord y vuelve a abrirlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que vous êtes connecté à Discord. Si la connexion échoue encore, quittez Discord puis rouvrez-le"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discordにサインインしていることを確認してください。それでも接続できない場合は、Discordを終了してからもう一度開いてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
