        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spessore del font della riga principale; la seconda riga e l’anteprima della riga successiva da espansa sono più leggere di un livello"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メイン行の文字の太さです。2行目と展開時の次の行のプレビューはメイン行より1段階細くなります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주 줄의 서체 두께입니다. 보조 줄과 펼쳤을 때의 다음 줄 미리보기는 주 줄보다 한 단계 가늘게 표시됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peso da fonte da linha principal; a segunda linha e a prévia da próxima linha ao expandir ficam um nível mais finas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насыщенность основной строки; вторая строка и превью следующей в развернутом виде на ступень тоньше"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "น้ำหนักแบบอักษรของบรรทัดหลัก บรรทัดรองและตัวอย่างบรรทัดถัดไปเมื่อขยายจะบางกว่าบรรทัดหลักหนึ่งระดับ"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Товщина основного рядка; другий рядок і наступний рядок у розгорнутому вигляді на крок тонші"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ đậm của dòng chính; dòng phụ và bản xem trước dòng tiếp theo khi mở rộng mảnh hơn dòng chính một bậc"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主行的字重；副行和展開時的下一句預覽比主行細一檔"
