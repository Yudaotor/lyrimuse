        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes salvos, mas não foi possível gravar a biblioteca de letras. Clique em “Atualizar backup” para tentar de novo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
