    "Last.fm 只接受约两周内的记录，更早的补不上去" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last.fm only accepts scrobbles from about the last two weeks; older ones can't be filled in"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last.fm 只接受约两周内的记录，更早的补不上去"
          }
        }
      }
    },
    "Last.fm 已确认收到这次播放" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last.fm has acknowledged this play"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last.fm 已确认收到这次播放"
          }
        }
      }
    },
    "Last.fm 拒绝了写入，Scrobble 已暂停——授权可能已在网站上被撤销" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last.fm is rejecting scrobbles, so scrobbling is paused. Your authorization may have been revoked on the Last.fm website"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last.fm 拒绝了写入，Scrobble 已暂停——授权可能已在网站上被撤销"
          }
        }
      }
    },
    "Last.fm 规则：需长于 30 秒且播完一半（或满 4 分钟）。专辑过场轨常达不到。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last.fm counts tracks over 30s played halfway (or 4 min). Interludes often miss."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last.fm 规则：需长于 30 秒且播完一半（或满 4 分钟）。专辑过场轨常达不到。"
          }
        }
      }
    },
