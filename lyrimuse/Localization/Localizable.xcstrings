        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna fuente de letras respondió cuando se buscó esta canción el %@, quizá porque no había red; no significa que la canción no tenga letra. Volver a buscar suele encontrarla"
