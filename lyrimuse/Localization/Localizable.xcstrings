        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In „%@“ geöffnet. Ändere bei Wort-für-Wort-Text nur die Wörter und behalte die Zeit am Zeilenanfang; Sichern übernimmt die Änderungen"
          }
        },
        "en" : {
