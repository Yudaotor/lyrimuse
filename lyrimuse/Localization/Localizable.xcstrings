        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La API de letras de Soda Music devolvió contenido no reconocido (puede haber cambiado). No significa que la canción no tenga letra; suele corregirse en una actualización posterior"
          }
        },
        "fr" : {
