    "未开启 · 开启后能认出 MV 和播客，并提前准备接下来几首的歌词" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus · Aktiviere sie, um Musikvideos und Podcasts zu erkennen und den Liedtext der nächsten Titel vorzubereiten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off · Turn it on to recognize music videos and podcasts and get lyrics ready for the next songs"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivada · Actívala para reconocer videoclips y pódcasts y tener lista la letra de las siguientes canciones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivée · Activez-la pour reconnaître les clips et les podcasts et préparer les paroles des morceaux suivants"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivata · Attivala per riconoscere video musicali e podcast e preparare il testo dei prossimi brani"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ · オンにするとMVとポッドキャストを判別し、次の数曲の歌詞を先に用意します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼짐 · 켜면 뮤직비디오와 팟캐스트를 구분하고 다음 몇 곡의 가사를 미리 준비합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativada · Ative para reconhecer clipes e podcasts e deixar pronta a letra das próximas músicas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выкл. · Включите, чтобы распознавать клипы и подкасты и заранее готовить текст следующих треков"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดอยู่ · เปิดเพื่อให้จดจำมิวสิควิดีโอและพ็อดคาสท์ได้ และเตรียมเนื้อเพลงของเพลงถัดไปไว้ล่วงหน้า"
          }
        },
        "uk" : {
