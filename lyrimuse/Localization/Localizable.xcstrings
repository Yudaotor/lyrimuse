          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกการตั้งค่าแล้ว แต่เขียนคลังเนื้อเพลงไม่สำเร็จ คลิก “อัปเดตข้อมูลสำรอง” เพื่อลองอีกครั้ง"
