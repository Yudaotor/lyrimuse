        }
      }
    },
    "当前播放的是伴奏版（歌名或专辑标注为伴奏、纯音乐或 Instrumental），不采用人声版歌词，按纯音乐显示" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is an instrumental version (its title or album is marked Instrumental). Vocal lyrics are not used, and it is shown as instrumental"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前播放的是伴奏版（歌名或专辑标注为伴奏、纯音乐或 Instrumental），不采用人声版歌词，按纯音乐显示"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前播放的是伴奏版（歌名或專輯標註為伴奏、純音樂或 Instrumental），不採用人聲版歌詞，按純音樂顯示"
          }
        }
      }
    },
