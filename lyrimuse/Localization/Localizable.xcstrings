    },
    "将听歌报告推送到手机、群聊或自建服务" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet Hörberichte an dein Handy, Gruppenchats oder deinen eigenen Dienst"
          }
