    "尚未连接 Apple Music。可在「歌词来源」卡片底部点按「连接」登录（需要 Apple Music 订阅）" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music ist noch nicht verbunden – melde dich einmal über „Verbinden“ unten in der Karte „Liedtextquellen“ an (Apple Music-Abo erforderlich)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music is not connected yet — sign in once via Connect at the bottom of the Lyrics Sources card (an Apple Music subscription is required)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music aún no está conectado. Inicia sesión con «Conectar», al final de la tarjeta «Fuentes de letras» (requiere suscripción a Apple Music)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music n’est pas encore connecté. Connectez-vous via « Connecter » en bas de la carte « Sources de paroles » (abonnement Apple Music requis)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music non è ancora connesso: accedi una volta con “Connetti” in fondo alla scheda “Fonti dei testi” (serve un abbonamento ad Apple Music)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Musicはまだ接続されていません。「歌詞ソース」カードの下部にある「接続」からサインインしてください（Apple Musicのサブスクリプションが必要です）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music이 아직 연결되지 않았습니다. ‘가사 소스’ 카드 하단의 ‘연결’을 클릭하여 로그인하십시오(Apple Music 구독 필요)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Music ainda não está conectado. Inicie sessão com “Conectar”, no fim do cartão “Fontes de letras” (requer assinatura do Apple Music)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music еще не подключен. Войдите, нажав «Подключить» внизу карточки «Источники текстов» (нужна подписка Apple Music)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ได้เชื่อมต่อ Apple Music คลิก “เชื่อมต่อ” ที่ด้านล่างของการ์ด “แหล่งเนื้อเพลง” เพื่อลงชื่อเข้า (ต้องสมัครสมาชิก Apple Music)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music ще не підʼєднано. Увійдіть через кнопку «Підʼєднати» внизу картки «Джерела текстів» (потрібна підписка Apple Music)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa kết nối Apple Music. Bấm vào “Kết nối” ở cuối thẻ “Nguồn lời bài hát” để đăng nhập (cần gói đăng ký Apple Music)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未连接 Apple Music。可在「歌词来源」卡片底部点按「连接」登录（需要 Apple Music 订阅）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未連線 Apple Music。可在「歌詞來源」卡片底部按一下「連線」登入（需要 Apple Music 訂閱）"
          }
        }
      }
    },
    "Apple Music 的登录已过期或被吊销（有效期 6 个月，Apple 不提供自动续期），请在「歌词来源」卡片底部重新连接" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Apple Music-Anmeldung ist abgelaufen oder wurde widerrufen (sie gilt 6 Monate, und Apple bietet keine Verlängerung) – verbinde dich unten in der Karte „Liedtextquellen“ neu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Apple Music sign-in has expired or been revoked (it lasts 6 months and Apple issues no renewable token) — reconnect at the bottom of the Lyrics Sources card"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión de Apple Music caducó o se revocó (dura 6 meses y Apple no ofrece renovación automática). Vuelve a conectarte al final de la tarjeta «Fuentes de letras»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion Apple Music a expiré ou été révoquée (valable 6 mois, sans renouvellement auto par Apple). Reconnectez-vous en bas de la carte « Sources de paroles »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso ad Apple Music è scaduto o è stato revocato (dura 6 mesi e Apple non offre il rinnovo automatico): riconnettiti in fondo alla scheda “Fonti dei testi”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Musicのサインインが期限切れになったか、取り消されました（有効期間は6か月で、Appleは自動更新を提供していません）。「歌詞ソース」カードの下部から再接続してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music 로그인이 만료되었거나 취소되었습니다(유효 기간 6개월, Apple은 자동 갱신을 제공하지 않음). ‘가사 소스’ 카드 하단에서 다시 연결하십시오"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão do Apple Music expirou ou foi revogada (dura 6 meses e a Apple não oferece renovação automática). Reconecte no fim do cartão “Fontes de letras”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок входа в Apple Music истек, или вход отозван (он действует 6 месяцев, Apple не продлевает его автоматически). Подключитесь снова внизу карточки «Источники текстов»"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลงชื่อเข้า Apple Music หมดอายุหรือถูกเพิกถอน (ใช้ได้ 6 เดือน และ Apple ไม่มีการต่ออายุอัตโนมัติ) โปรดเชื่อมต่อใหม่ที่ด้านล่างของการ์ด “แหล่งเนื้อเพลง”"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термін входу в Apple Music минув або його відкликано (вхід діє 6 місяців, Apple не продовжує його автоматично). Підʼєднайте знову внизу картки «Джерела текстів»"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập Apple Music đã hết hạn hoặc bị thu hồi (hiệu lực 6 tháng, Apple không hỗ trợ tự động gia hạn), hãy kết nối lại ở cuối thẻ “Nguồn lời bài hát”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music 的登录已过期或被吊销（有效期 6 个月，Apple 不提供自动续期），请在「歌词来源」卡片底部重新连接"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music 的登入已過期或被撤銷（有效期 6 個月，Apple 不提供自動續期），請在「歌詞來源」卡片底部重新連線"
          }
        }
      }
    },
    "无法获取 Apple Music 接口的公共访问令牌（无法连接 music.apple.com），可能是网络问题，稍后重试通常可恢复" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
