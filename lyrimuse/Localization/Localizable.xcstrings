          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 곡씩 온라인으로 검색하며 곡 간격은 약 5초입니다. 연주곡과 직접 수정한 노래는 건너뜁니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
