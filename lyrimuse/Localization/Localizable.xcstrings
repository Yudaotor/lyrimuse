          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca canción por canción, con unos 5 segundos entre cada una. Se omiten las instrumentales y las editadas manualmente"
          }
        },
        "fr" : {
          "stringUnit" : {
