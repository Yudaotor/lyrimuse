    "未授权时无法准确读取播放进度，也无法控制播放" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne sie driftet die Wiedergabeposition und die Steuerung funktioniert nicht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without it, the playback position drifts and the controls do nothing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin él, la posición de reproducción se desvía y los controles no funcionan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans elle, la position de lecture dérive et les commandes sont inopérantes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza permesso, la posizione di riproduzione si sfasa e i controlli non funzionano"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可しないと、再生位置を正確に読み取れず、再生を操作することもできません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용하지 않으면 재생 위치를 정확히 읽을 수 없고 재생을 제어할 수 없습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem ela, a posição de reprodução fica imprecisa e os controles não funcionam"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без разрешения позиция воспроизведения считывается неточно, а управлять воспроизведением нельзя"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่อนุญาต จะอ่านตำแหน่งการเล่นได้ไม่แม่นยำและควบคุมการเล่นไม่ได้"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без дозволу позиція відтворення визначається неточно, а керування не працює"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không cấp quyền, vị trí phát sẽ không chính xác và không thể điều khiển phát"
          }
        },
        "zh-Hans" : {
