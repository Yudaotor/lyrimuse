        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 빌드는 패키징 시 가사 엔진의 버전 번호가 동기화되지 않았습니다. 기능에는 영향이 없으며 가사 엔진 코드는 앱과 같은 버전이므로 아무것도 할 필요가 없습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
