          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В системе включено «Уменьшение движения», поэтому текст в Touch Bar не прокручивается и не подсвечивается по словам"
          }
        },
        "th" : {
