    "辅助功能权限可提高%@播放进度的准确性，并显示随机、循环按钮" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bedienungshilfen“ hält die Wiedergabeposition von %@ genau und zeigt die Tasten für Zufall und Wiederholen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility keeps %@’s playback position accurate and shows its shuffle and repeat buttons"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El permiso de accesibilidad mantiene precisa la posición de reproducción de %@ y muestra sus botones de aleatorio y repetir"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation Accessibilité maintient la précision de la position de lecture de %@ et affiche ses boutons Aléatoire et Répéter"
