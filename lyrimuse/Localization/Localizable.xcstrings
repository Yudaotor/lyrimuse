    "无法从 Deezer 获取匿名访问令牌（与歌曲是否有歌词无关，通常稍后重试即可恢复）" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein anonymes Zugriffstoken von Deezer erhalten (unabhängig davon, ob der Titel einen Liedtext hat; ein späterer Versuch klappt meist)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t get an anonymous access token from Deezer (unrelated to whether the song has lyrics; retrying later usually works)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo obtener un token de acceso anónimo de Deezer (no depende de si la canción tiene letra; suele funcionar más tarde)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’obtenir un jeton d’accès anonyme de Deezer (sans lien avec la présence de paroles ; réessayer plus tard fonctionne généralement)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile ottenere un token di accesso anonimo da Deezer (non dipende dal fatto che il brano abbia un testo; di solito riprovare più tardi funziona)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezerから匿名アクセストークンを取得できませんでした（曲に歌詞があるかどうかとは関係なく、通常はしばらくしてから再試行すると回復します）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deezer에서 익명 접근 토큰을 가져올 수 없습니다(노래에 가사가 있는지와는 무관하며 보통 잠시 후 다시 시도하면 복구됩니다)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível obter um token de acesso anônimo do Deezer (sem relação com a música ter letra; tentar mais tarde costuma funcionar)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось получить анонимный токен доступа Deezer (не связано с тем, есть ли у трека текст; обычно помогает повторить позже)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับโทเค็นการเข้าถึงแบบไม่ระบุตัวตนจาก Deezer ไม่ได้ (ไม่เกี่ยวกับว่าเพลงมีเนื้อเพลงหรือไม่ โดยปกติลองอีกครั้งในภายหลังก็จะใช้ได้)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося отримати анонімний токен доступу від Deezer (це не залежить від того, чи є в пісні текст; зазвичай допомагає повторити згодом)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không lấy được token truy cập ẩn danh từ Deezer (không liên quan đến việc bài hát có lời hay không; thường thử lại sau là được)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从 Deezer 获取匿名访问令牌（与歌曲是否有歌词无关，通常稍后重试即可恢复）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法從 Deezer 取得匿名存取權杖（與歌曲是否有歌詞無關，通常稍後重試即可恢復）"
          }
        }
      }
    },
