    "指针悬停在封面上时也显示此行" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch beim Bewegen des Zeigers über das Cover sichtbar"
