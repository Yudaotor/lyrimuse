          "stringUnit" : {
            "state" : "translated",
            "value" : "Automation access keeps %@’s playback progress accurate and lets you control playback right from the lyrics"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso de automatización mantiene exacto el progreso de reproducción de %@ y te permite controlar la reproducción desde la letra"
