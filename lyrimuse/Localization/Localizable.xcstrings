    "所选屏幕没有常驻的菜单栏，歌词仍显示在图标旁" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gewählte Display hat keine dauerhaft sichtbare Menüleiste, daher bleibt der Text neben dem Symbol"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected display has no menu bar that stays visible, so lyrics stay beside the icon"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla seleccionada no tiene una barra de menús siempre visible, así que la letra sigue junto al icono"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran choisi n’a pas de barre des menus toujours visible, les paroles restent à côté de l’icône"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したディスプレイには常に表示されるメニューバーがないため、歌詞はアイコンの横に表示されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 디스플레이에 항상 표시되는 메뉴 막대가 없어 가사가 아이콘 옆에 표시됩니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选屏幕没有常驻的菜单栏，歌词仍显示在图标旁"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所選螢幕沒有常駐的選單列，歌詞仍顯示在圖像旁"
          }
        }
      }
    },
    "菜单栏正中：歌词显示在菜单栏中间，避开 App 菜单、右侧图标和刘海" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitte: Der Text erscheint in der Mitte der Menüleiste, abseits von App-Menüs, den Symbolen rechts und der Notch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Center: lyrics appear in the middle of the menu bar, clear of app menus, the icons on the right and the notch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
