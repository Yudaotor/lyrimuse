        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create an app at api.slack.com/apps (From scratch) and pick your workspace. Turn on Incoming Webhooks, click “Add New Webhook”, choose the channel to post to, then copy the Webhook URL"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una app en api.slack.com/apps (From scratch) y elige tu espacio de trabajo. Activa Incoming Webhooks, haz clic en «Add New Webhook», elige el canal donde publicar y copia la URL del webhook"
          }
        },
        "fr" : {
