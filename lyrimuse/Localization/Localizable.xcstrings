        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✓ Работает сейчас, но только до перезапуска браузера: параметр выше выключен, поэтому после перезапуска работать перестанет"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✓ ใช้ได้ในขณะนี้ แต่จะใช้ได้จนกว่าจะเปิดเบราว์เซอร์ใหม่เท่านั้น เพราะตัวเลือกด้านบนปิดอยู่ หลังเปิดใหม่จะใช้ไม่ได้"
          }
