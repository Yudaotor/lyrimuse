          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимает флажок Spotify в разделе «Плееры для скробблинга». Прослушивания Spotify на других устройствах, например на телефоне, по-прежнему записываются"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
