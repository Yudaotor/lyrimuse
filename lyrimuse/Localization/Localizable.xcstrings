          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’API dei testi di Soda Music ha restituito contenuti non riconosciuti (l’API potrebbe essere cambiata). Non significa che il brano sia senza testo; di solito un aggiornamento successivo risolve"
          }
        },
        "ja" : {
