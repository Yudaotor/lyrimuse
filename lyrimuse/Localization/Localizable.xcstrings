        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva questo permesso per calibrare la posizione di %@ dopo un salto nel brano, mostrare il pulsante Ripeti e il controllo del volume e controllare la riproduzione quando perde il focus multimediale di sistema"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この権限をオンにすると、%@で再生位置を移動したあとの位置を補正し、リピートボタンと音量調整を表示して、システムのメディアフォーカスがないときも再生を操作できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 권한을 켜면 %@에서 재생 위치를 이동한 후의 위치를 보정하고, 반복 버튼과 음량 조절을 표시하며, 시스템 미디어 포커스를 잃었을 때도 재생을 제어할 수 있습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative para calibrar o tempo de %@ após mudar a posição, mostrar os botões de repetição e de volume e controlar a reprodução quando ele perder o foco de mídia do sistema"
          }
        },
        "ru" : {
          "stringUnit" : {
