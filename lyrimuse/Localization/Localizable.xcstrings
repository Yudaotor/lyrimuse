        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘ 키를 누른 채 이 아이콘을 드래그하면 메뉴 막대의 원하는 위치로 옮길 수 있습니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
