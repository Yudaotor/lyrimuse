    "连续混音版，与原版编排不同" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchgehender Mix, anders arrangiert als das Original"
          }
        },
        "en" : {
          "stringUnit" : {
