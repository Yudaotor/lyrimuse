    "所选屏幕没有常驻的菜单栏，歌词仍显示在图标旁" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gewählte Display hat keine dauerhaft sichtbare Menüleiste, daher bleibt der Text neben dem Symbol"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected display has no menu bar that stays visible, so lyrics stay beside the icon"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla seleccionada no tiene una barra de menús siempre visible, así que la letra sigue junto al icono"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran choisi n’a pas de barre des menus toujours visible, les paroles restent à côté de l’icône"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo schermo selezionato non ha una barra dei menu sempre visibile, quindi il testo resta accanto all’icona"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したディスプレイには常に表示されるメニューバーがないため、歌詞はアイコンの横に表示されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 디스플레이에 항상 표시되는 메뉴 막대가 없어 가사가 아이콘 옆에 표시됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela selecionada não tem uma barra de menus sempre visível, então a letra fica ao lado do ícone"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На выбранном дисплее строка меню не всегда видна, поэтому текст остается рядом со значком"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จอภาพที่เลือกไม่มีแถบเมนูที่แสดงตลอด เนื้อเพลงจึงยังแสดงข้างไอคอน"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вибраному дисплеї смуга меню не показується постійно, тому текст лишається біля значка"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màn hình đã chọn không có thanh menu luôn hiển thị, lời vẫn hiện cạnh biểu tượng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选屏幕没有常驻的菜单栏，歌词仍显示在图标旁"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所選螢幕沒有常駐的選單列，歌詞仍顯示在圖像旁"
          }
        }
      }
    },
    "菜单栏正中：歌词显示在菜单栏中间，避开 App 菜单、右侧图标和刘海" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitte: Der Text erscheint in der Mitte der Menüleiste, abseits von App-Menüs, den Symbolen rechts und der Notch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Center: lyrics appear in the middle of the menu bar, clear of app menus, the icons on the right and the notch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centro: la letra aparece en medio de la barra de menús, sin tapar los menús de las apps, los iconos de la derecha ni el notch"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au centre : les paroles s’affichent au milieu de la barre des menus, à l’écart des menus des apps, des icônes de droite et de l’encoche"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al centro: il testo appare al centro della barra dei menu, lontano dai menu delle app, dalle icone a destra e dal notch"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中央：Appのメニュー、右側のアイコン、ノッチを避けて、メニューバーの中央に歌詞を表示します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 가운데: 가사가 앱 메뉴, 오른쪽 아이콘, 노치를 피해 메뉴 막대 가운데에 표시됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centro: a letra aparece no meio da barra de menus, sem cobrir os menus de apps, os ícones à direita nem o notch"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По центру: текст в середине строки меню, не перекрывая меню приложений, значки справа и вырез"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กึ่งกลาง: เนื้อเพลงแสดงตรงกลางแถบเมนู โดยเลี่ยงเมนูของแอป ไอคอนด้านขวา และรอยบาก"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«По центру»: текст показується посередині смуги меню й не закриває меню програм, значки праворуч і виріз"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữa thanh menu: lời hiện ở giữa thanh menu, tránh menu ứng dụng, biểu tượng bên phải và notch"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单栏正中：歌词显示在菜单栏中间，避开 App 菜单、右侧图标和刘海"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選單列正中：歌詞顯示在選單列中間，避開 App 選單、右側圖像和瀏海"
          }
        }
      }
    },
