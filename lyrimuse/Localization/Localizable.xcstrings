    "行上按 %1$@ 次计，明细合计 %2$@ 次" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The row counts %1$@, the breakdown totals %2$@"
