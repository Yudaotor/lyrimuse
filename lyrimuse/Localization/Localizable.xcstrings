    "「自动」按对唱声部对齐，合唱居中，无对唱信息时靠左" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Auto“ folgt den Duettstimmen: Chorpassagen zentriert, Zeilen ohne Duettinfo links"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
