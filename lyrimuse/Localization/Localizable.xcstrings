    "悬浮歌词、灵动岛、菜单栏和触控栏可同时开，歌词窗口按需打开" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwebender Text, Notch, Menüleiste und Touch Bar können gleichzeitig laufen; öffne das Liedtextfenster bei Bedarf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floating Lyrics, Notch, Menu Bar and Touch Bar can run together; open the Lyrics Window when needed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La letra flotante, el notch, la barra de menús y la Touch Bar pueden usarse a la vez; abre la ventana de letra cuando la necesites"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paroles flottantes, Encoche, Barre des menus et Touch Bar peuvent fonctionner ensemble ; ouvrez la Fenêtre des paroles au besoin"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フローティング歌詞、ノッチ、メニューバー、Touch Barは同時に使用でき、歌詞ウインドウは必要に応じて開けます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플로팅 가사, 노치, 메뉴 막대, Touch Bar는 동시에 켤 수 있으며 가사 윈도우는 필요할 때 엽니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬浮歌词、灵动岛、菜单栏和触控栏可同时开，歌词窗口按需打开"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浮動歌詞、動態島、選單列和觸控列可同時開，歌詞視窗按需打開"
          }
        }
      }
    },
    "当前系统未提供触控栏接口，开启后不生效" : {
