            "value" : "10초 동안 일시 정지되면 Control Strip 버튼으로 접히고, 재생을 재개하면 자동으로 펼쳐집니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停 10 秒后收起为功能栏图标，恢复播放时自动展开"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫停 10 秒後收起為功能列圖像，恢復播放時自動展開"
