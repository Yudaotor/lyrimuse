        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-приложение для iPhone. На его главном экране — ваш адрес, отчеты приходят прямо на iPhone. Бесплатно и с открытым кодом"
          }
        },
        "th" : {
          "stringUnit" : {
