    "设置已保存；歌词库写入失败，可再次点按「更新备份」" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen gesichert, aber die Liedtext-Bibliothek konnte nicht geschrieben werden. Klicke erneut auf „Backup aktualisieren“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings saved, but the lyrics library couldn’t be written. Click Update Backup to try again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes guardados, pero no se pudo escribir la biblioteca de letras. Haz clic en «Actualizar copia» para reintentarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
