    "间奏中多出一段歌词" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusätzlicher Text im Instrumentalteil"
          }
        },
        "en" : {
