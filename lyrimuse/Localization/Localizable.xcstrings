          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turned off in System Settings › General › Login Items, so Lyrimuse won’t open at login"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado en Ajustes del Sistema › General › Ítems de inicio, así que Lyrimuse no se abrirá al iniciar sesión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
