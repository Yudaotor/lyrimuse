        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows elapsed time and track length at the top of the mini size"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷你尺寸頂部顯示「已播到哪 / 這首多長」"
