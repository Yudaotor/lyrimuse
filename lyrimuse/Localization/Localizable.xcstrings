    "逐首联网搜索，每首间隔约 5 秒；跳过纯音乐和人工修正过的歌曲" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sucht Titel für Titel im Abstand von etwa 5 Sekunden. Instrumentals und manuell bearbeitete Titel werden übersprungen"
          }
        },
        "en" : {
          "stringUnit" : {
