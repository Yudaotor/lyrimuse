        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a segment of a DJ Mix album (the title is tagged [Mixed] and the album (DJ Mix)). Such tracks are cut from a full set with transitions on either side and a different length, so the original lyrics’ timing can’t line up, and no lyrics source provides timing for the mixed version"
          }
