      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bewegung reduzieren“ ist aktiv, daher scrollt der Text in der Touch Bar nicht und leuchtet nicht Wort für Wort auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce Motion is on, so Touch Bar lyrics don’t scroll or light up word by word"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Reducir movimiento» está activado, así que la letra de la Touch Bar no se desplaza ni se ilumina palabra por palabra"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Réduire les animations » est activé : les paroles de la Touch Bar ne défilent pas et ne s’allument pas mot à mot"
