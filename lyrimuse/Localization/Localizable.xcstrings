{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "简洁" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compact"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡潔"
          }
        }
      }
    },
    "多行" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多行"
          }
        }
      }
    },
    "歌词布局" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyrics Layout"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞佈局"
          }
        }
      }
    },
    "简洁：只显示当前句和下一句。\n多行：像完整尺寸那样整页滚动显示歌词。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compact: only the current line and the next one.\nFull: a scrolling page of lyrics, like the full size."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡潔：只顯示目前這句和下一句。\n多行：像完整尺寸那樣整頁捲動顯示歌詞。"
          }
        }
      }
    },
    "迷你尺寸只显示当前句和下一句，还是像完整尺寸那样整页滚动" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether the mini size shows just the current and next line, or a scrolling page like the full size"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷你尺寸只顯示目前這句和下一句，還是像完整尺寸那樣整頁捲動"
          }
        }
      }
    },
    "作用于歌词、顶部信息和控制条；「自动」会按背景亮度在浅色和深色之间切换" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the lyrics, header, and controls. Auto switches between light and dark based on the background's brightness."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作用於歌詞、頂部資訊和控制列；「自動」會依背景亮度在淺色和深色之間切換"
          }
        }
      }
    },
    "仅作用于歌词；顶部信息和控制条仍用系统字体" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyrics only; the header and controls keep the system font."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅作用於歌詞；頂部資訊和控制列仍用系統字體"
          }
        }
      }
    },
    "歌词窗口的背景：跟随封面／纯色／渐变／毛玻璃" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lyrics window's background: follow artwork, solid, gradient, or frosted glass"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞視窗的背景：跟隨封面／純色／漸層／毛玻璃"
          }
        }
      }
    },
    "歌词窗口的文字颜色；「自动」会按背景亮度在浅色和深色之间切换" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lyrics window's text color. Auto switches between light and dark based on the background's brightness."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞視窗的文字顏色；「自動」會依背景亮度在淺色和深色之間切換"
          }
        }
      }
    },
    "迷你尺寸顶部显示歌名／歌手／专辑" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the title, artist, and album at the top of the mini size"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷你尺寸頂部顯示歌名／歌手／專輯"
          }
        }
      }
    },
    "只恢复当前预览的尺寸" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the size shown in the preview"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只恢復目前預覽的尺寸"
          }
        }
      }
    },
    "换行（默认）：一行放不下就折到下一行。\n滚动：每行只占一行高，放不下的横向滚动；这一句有逐字时间轴时跟着唱到哪滚到哪。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrap (default): long lines fold onto the next line.\nScroll: every line stays one line tall and the overflow scrolls sideways — following the singing when the line has word-level timings."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "換行（預設）：一行放不下就折到下一行。\n捲動：每行只佔一行高，放不下的橫向捲動；這一句有逐字時間軸時跟著唱到哪捲到哪。"
          }
        }
      }
    },
    "迷你尺寸一行放不下时换行还是滚动" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether long lines wrap or scroll in the mini size"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷你尺寸一行放不下時換行還是捲動"
          }
        }
      }
    },
    "迷你尺寸顶部信息左边那枚封面小图" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The small artwork thumbnail beside the mini size's top info"
