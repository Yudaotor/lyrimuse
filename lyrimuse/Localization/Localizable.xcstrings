        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyrics flow left to right in rainbow colors, darkened on a light menu bar; system colors return while the menu is open"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La letra fluye de izquierda a derecha con los colores del arcoíris, más oscura en una barra de menús clara; los colores del sistema vuelven mientras el menú está abierto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles défilent de gauche à droite aux couleurs de l’arc-en-ciel, assombries sur une barre des menus claire ; les couleurs du système reviennent quand le menu est ouvert"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo scorre da sinistra a destra nei colori dell’arcobaleno, scurito su una barra dei menu chiara; i colori di sistema tornano mentre il menu è aperto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞が左から右へ流れるレインボーカラーになり、明るいメニューバーでは自動的に暗くなります。メニューを開いて反転表示している間はシステムの色に戻ります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가사가 왼쪽에서 오른쪽으로 흐르는 무지개 색상으로 표시되며, 밝은 메뉴 막대에서는 자동으로 어둡게 표시됩니다. 메뉴가 열려 강조 표시되는 동안에는 시스템 색상으로 돌아갑니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A letra flui da esquerda para a direita nas cores do arco-íris, mais escura em uma barra de menus clara; as cores do sistema voltam enquanto o menu está aberto"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст переливается радугой слева направо, на светлой строке меню затемняется; пока меню открыто, возвращаются системные цвета"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เนื้อเพลงไหลเป็นสีรุ้งจากซ้ายไปขวา และปรับให้เข้มขึ้นบนแถบเมนูสีอ่อน ขณะเปิดเมนูจะกลับเป็นสีของระบบ"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст переливається веселкою зліва направо, на світлій смузі меню автоматично затемнюється; поки меню відкрите, повертаються системні кольори"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời chuyển màu cầu vồng chạy từ trái sang phải, tự tối đi trên thanh menu sáng; trở lại màu hệ thống khi mở menu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌词换成从左往右流动的彩虹，浅色菜单栏上自动压暗；打开菜单反白期间恢复系统颜色"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞換成由左往右流動的彩虹，淺色選單列上自動壓暗；打開選單反白期間恢復系統顏色"
          }
        }
      }
    },
