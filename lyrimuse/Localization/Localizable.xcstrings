        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Riduci movimento” è attivo, quindi il testo nella Touch Bar non scorre e non si illumina parola per parola"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
