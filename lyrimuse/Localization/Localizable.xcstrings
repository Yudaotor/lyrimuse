            "value" : "Поточний текст ви змінили або вибрали вручну, його не обрано автоматичним рішенням нижче"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời hiện tại do bạn sửa hoặc chọn thủ công, không phải kết quả của quyết định tự động bên dưới"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
