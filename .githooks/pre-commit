#!/bin/sh
# 提交前的几道闸,顺序跟 CI 一致:
#
#   0. 内置播放器生成物对账:碰了 shared/players.json 或它的生成物时,两侧生成物必须是
#      重新生成过的。只有这道闸查得出"改了 JSON 忘了跑生成器"——生成物本身是合法代码,
#      编译不会红。
#
#   1. gofmt:暂存的 .go 文件必须已格式化。CI 的第一步就是 `gofmt -l lyrimuse-engine`,
#      本地不拦一道就得推上去才知道,而且一路红下去很容易没人注意。
#   2. 注释卫生:拦住把过程性内容写进代码注释的提交(日期戳、迭代编号、人物归因、
#      工单引用、排查叙述、临时状态、emoji 标记),以及源码里真的不可见字符(不换行空格、零宽字符、
#      BOM 等,要写成转义)。规则全文在 scripts/check-comment-hygiene.py 的文档字符串里,那份是唯一真源,
#      这里只负责在提交那一刻跑它。
#
#   另有一道 README 闸:改了 README 就跑引擎里核对「歌词源数量」的那条测试。只改文案的提交
#   没有源码文件,下面三道都不跑,措辞改掉了测试认的写法要推到 CI 才发现。
#
# 为什么是 hook 而不是只写进文档:这个仓的 AGENTS.md / CLAUDE.md 都在 .gitignore 里,
# 约定只对读过它的人生效,而注释是最容易顺手写脏的地方 —— 一次全仓清理要动 500+ 个文件,
# 复发一次就得再来一遍。只查**本次暂存的文件**,不扫全仓,所以基本无感。
#
# 确实需要放行时用 git commit --no-verify(别拿它当常规手段)。

root=$(git rev-parse --show-toplevel) || exit 0

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# ---- 闸 0:内置播放器生成物对账 ----
#
# 两侧十几张"每播放器一行"的表由 shared/players.json 生成。生成物过期(改了 JSON 忘了跑
# 生成器)或被手改时**编译照样过** —— 它本身是合法代码,只有对账查得出来。
# 必须排在下面那个 early exit 前面:只改 JSON 的提交里一个源码文件都没有,放到后面就漏了。
# 只在这次提交真碰了这几个文件时才跑,别的提交不受影响。
case "$staged" in
    *shared/players.json*|*players_generated.go*|*PlaybackPlayer+Generated.swift*|*PlaybackPlayerMeta+Generated.swift*)
        python3 "$root/scripts/gen-players.py" --check >/dev/null 2>&1 || {
            echo "" >&2
            echo "  内置播放器的生成物跟 shared/players.json 对不上。" >&2
            echo "  跑 python3 scripts/gen-players.py 重新生成,把结果一起提交。" >&2
            echo "  确实要放行:git commit --no-verify" >&2
            echo "" >&2
            exit 1
        }
        ;;
esac

# 歌词声明行规则同理:两侧规则表与例句由 shared/lyric-notices.json 生成,过期了编译照样过。
case "$staged" in
    *shared/lyric-notices.json*|*lyricnotices_generated*|*LyricNotices+Generated.swift*|*LyricNoticeExamples+Generated.swift*)
        python3 "$root/scripts/gen-lyric-notices.py" --check >/dev/null 2>&1 || {
            echo "" >&2
            echo "  歌词声明行规则的生成物跟 shared/lyric-notices.json 对不上。" >&2
            echo "  跑 python3 scripts/gen-lyric-notices.py 重新生成,把结果一起提交。" >&2
            echo "  确实要放行:git commit --no-verify" >&2
            echo "" >&2
            exit 1
        }
        ;;
esac

# ---- README 闸:歌词源数量 ----
#
# 三份 README 各有几处写着「一共几个歌词源」,由 TestDocsSourceCountMatchesSourceCount 跟常量表对账。
# 必须排在下面那个 early exit 前面:只改 README 的提交一个源码文件都没有。读的是工作区那份(同 gofmt)。
# 没装 Go 就放行,理由同闸 1。
case "$staged" in
    *README.md*|*README.zh-CN.md*|*README.zh-Hant.md*)
        if command -v go >/dev/null 2>&1; then
            out=$(cd "$root/lyrimuse-engine" && go test -count=1 -run '^TestDocsSourceCountMatchesSourceCount$' . 2>&1) || {
                echo "" >&2
                if printf '%s\n' "$out" | grep -q 'lyricsourceregistry_test.go'; then
                    printf '%s\n' "$out" | grep 'lyricsourceregistry_test.go' | sed 's/^ */    /' >&2
                    echo "  README 里写的歌词源数量跟代码对不上(或写法认不出来了),CI 的 go test 那步会挂。" >&2
                else
                    # 测试没跑起来(多半是引擎此刻编译不过):原样给出末尾几行。
                    printf '%s\n' "$out" | tail -n 8 | sed 's/^/    /' >&2
                    echo "  核对歌词源数量的测试没跑起来,见上面的输出。" >&2
                fi
                echo "  确实要放行:git commit --no-verify" >&2
                echo "" >&2
                exit 1
            }
        fi
        ;;
esac

# 只看本次新增/改动的、检查器认得的源码文件(删除的不算)。
files=$(printf '%s\n' "$staged" | grep -E '\.(swift|go|js|mjs|ts|py|sh)$')
[ -n "$files" ] || exit 0

# ---- 闸 1:gofmt ----
#
# gofmt 读的是**工作区**那份、不是暂存那份(注释检查器同口径)。只暂存了一个文件的
# 一部分时,它报的是磁盘上的内容,不是将要提交的内容。
# 机器上没有 gofmt 就直接放行 —— 这道闸不该把没装 Go 工具链的人挡在提交外面;
# CI 那边照样会拦,漏报的代价有兜底,误拦没有。
gofiles=$(printf '%s\n' "$files" | grep '\.go$')
if [ -n "$gofiles" ] && command -v gofmt >/dev/null 2>&1; then
    unformatted=$(printf '%s\n' "$gofiles" | tr '\n' '\0' | xargs -0 gofmt -l)
    if [ -n "$unformatted" ]; then
        echo "" >&2
        echo "  这些 Go 文件没格式化,CI 的 gofmt 那步会挂:" >&2
        printf '%s\n' "$unformatted" | sed 's/^/    /' >&2
        echo "  跑 gofmt -w 修一下再提交。" >&2
        echo "  确实要放行:git commit --no-verify" >&2
        echo "" >&2
        exit 1
    fi
fi

# ---- 闸 2:注释卫生 ----
checker="$root/scripts/check-comment-hygiene.py"
[ -f "$checker" ] || exit 0

# shellcheck disable=SC2086
printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 python3 "$checker" || {
    echo "" >&2
    echo "  ↑ 注释里出现了过程性内容,或源码里有真的不可见字符。注释只写现状与约束,过程归 git 和 docs/;" >&2
    echo "    不可见字符写成转义(反斜杠 u 加码点)。" >&2
    echo "  规则与改法见 scripts/check-comment-hygiene.py 开头。" >&2
    echo "  确实要放行:git commit --no-verify" >&2
    echo "" >&2
    exit 1
}
exit 0
