#!/bin/sh
# 拦住任何会在 GitHub 上产生 issue / PR 引用的写法(2026-09-17,用户定的规则:
# 「以后提交都不允许引用任何 issue」)。
#
# 为什么是 hook 而不是写进文档:这个仓的 AGENTS.md / CLAUDE.md 都在 .gitignore 里、
# 文件本身也不存在,而记忆 / 提醒类的约束实测拦不住 —— 761df77 就是这么把一条
# "added a commit that references this issue" 永久留在 issue timeline 上的
# (GitHub 那条事件记录删不掉,force push 也未必能让它消失)。
#
# GitHub 认这几种写法,全拦:
#   #123            行内的井号编号(行首 # 是 git 自己的注释行,已剔除)
#   GH-123
#   owner/repo#123
#   https://github.com/owner/repo/issues/123 或 /pull/123
#
# 想指向某个 issue 就去掉井号写成「issue 8」—— 人看得懂,GitHub 不会建引用。
# 确实需要放行时用 git commit --no-verify(别拿它当常规手段)。

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# git 会把 '#' 开头的整行当注释剔掉,它们不进 message,这里也不该算。
body=$(grep -v '^#' "$msg_file")

pattern='(^|[^A-Za-z0-9_/])#[0-9]+|(^|[^A-Za-z0-9_-])GH-[0-9]+|[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+|https?://github\.com/[^[:space:]]+/(issues|pull)/[0-9]+'

hits=$(printf '%s\n' "$body" | grep -nE "$pattern")
if [ -n "$hits" ]; then
    echo "" >&2
    echo "✗ 提交信息里出现了会被 GitHub 当成 issue/PR 引用的写法:" >&2
    echo "" >&2
    printf '%s\n' "$hits" | sed 's/^/    /' >&2
    echo "" >&2
    echo "  规则(2026-09-17 用户定):提交一律不引用任何 issue。" >&2
    echo "  改法:去掉井号,写成「issue 8」这样 —— 人看得懂,GitHub 不会建引用。" >&2
    echo "  一旦推上去,那条 timeline 记录就删不掉了。" >&2
    echo "" >&2
    exit 1
fi
exit 0
