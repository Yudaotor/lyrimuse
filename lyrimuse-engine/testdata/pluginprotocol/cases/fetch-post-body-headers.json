{
  "id": "fetch-post-body-headers",
  "category": "fetch",
  "title": "POST:方法、请求头、正文原样上线;请求头名不分大小写",
  "subject": "both",
  "covers": ["host/fetch"],
  "fixture": {
    "manifest": "manifests/basic.json",
    "plugin": "plugins/probe.js",
    "http": [
      {
        "request": {"method": "POST", "url": "https://lyrics.example/submit"},
        "response": {"status": 200, "headers": [["content-type", "application/json"]], "body": "{\"ok\":true}"}
      }
    ]
  },
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "post", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "playing"
    },
    {"before": "shutdown", "do": "stop"}
  ],
  "steps": [
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {
      "label": "search",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "post",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "post",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "post", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1", "sample": 1},
        "method": "host/fetch",
        "params": {
          "call": {"$var": "c1"},
          "request": {
            "url": "https://lyrics.example/submit",
            "method": "POST",
            "headers": {
              "$oneOf": [
                {"Content-Type": "application/json", "X-Fixture": "1"},
                {"content-type": "application/json", "x-fixture": "1"}
              ]
            },
            "body": {"encoding": "utf8", "data": "{\"k\":1}"}
          }
        }
      }
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1"},
        "result": {
          "status": 200,
          "headers": {"$any": "array", "sample": [["content-type", "application/json"]]},
          "url": "https://lyrics.example/submit",
          "redirected": false,
          "body": {"encoding": "utf8", "data": "{\"ok\":true}"}
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1"},
        "result": {
          "items": [
            {
              "id": "post",
              "title": "post",
              "artist": "Lyrimuse Test Band",
              "lyrics": {"plain": "200\nhttps://lyrics.example/submit\nfalse\n{\"ok\":true}"}
            }
          ]
        }
      }
    },
    {"observe": {"task": "t1", "outcome": {"status": "FOUND"}}},
    {"include": "fragments/bye.json"}
  ]
}
