{
  "id": "cancel-host-cancels-own-fetch",
  "category": "cancel",
  "title": "插件自己 abort 了一个 fetch:plugin-host 发 $/cancelRequest,引擎回 -32800",
  "subject": "both",
  "covers": ["$/cancelRequest", "host/fetch"],
  "fixture": {
    "manifest": "manifests/basic.json",
    "plugin": "plugins/probe.js",
    "http": [{"request": {"method": "GET", "url": "https://lyrics.example/slow"}, "fail": "hang"}]
  },
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "abort-own", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "playing"
    },
    {"before": "shutdown", "do": "stop"}
  ],
  "steps": [
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {
      "label": "search",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "abort-own",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "abort-own",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "abort-own", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1", "sample": 1},
        "method": "host/fetch",
        "params": {"call": {"$var": "c1"}, "request": {"url": "https://lyrics.example/slow", "method": {"$optional": "GET"}}}
      }
    },
    {"from": "host", "message": {"jsonrpc": "2.0", "method": "$/cancelRequest", "params": {"id": {"$var": "f1"}}}},
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1"},
        "error": {"code": -32800, "message": {"$any": "string", "sample": "error"}}
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1"},
        "result": {
          "items": [{"id": "abort-own", "title": "abort-own", "artist": "Lyrimuse Test Band", "lyrics": {"plain": "aborted"}}]
        }
      }
    },
    {"include": "fragments/bye.json"}
  ]
}
