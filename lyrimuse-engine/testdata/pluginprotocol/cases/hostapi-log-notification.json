{
  "id": "hostapi-log-notification",
  "category": "hostapi",
  "title": "host/log 是通知:引擎不应答",
  "subject": "both",
  "covers": ["host/log", "host/fetch"],
  "fixture": {
    "manifest": "manifests/basic.json",
    "plugin": "plugins/probe.js",
    "http": [
      {
        "request": {"method": "GET", "url": "https://lyrics.example/echo"},
        "response": {"status": 200, "headers": [["content-type", "application/json"]], "body": "hello"}
      }
    ]
  },
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "log", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "playing"
    },
    {"before": "shutdown", "do": "stop"}
  ],
  "ambient": ["$/heartbeat"],
  "steps": [
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {
      "label": "search",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "log",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "log",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "log", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "method": "host/log",
        "params": {
          "call": {"$optional": {"$var": "c1"}},
          "level": {"$any": "string", "sample": "info"},
          "message": "fixture says hi"
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1", "sample": 2},
        "method": "host/fetch",
        "params": {"call": {"$var": "c1"}, "request": {"url": "https://lyrics.example/echo", "method": {"$optional": "GET"}}}
      }
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1"},
        "result": {
          "status": 200,
          "headers": {"$any": "array", "sample": [["content-type", "application/json"]]},
          "url": "https://lyrics.example/echo",
          "redirected": false,
          "body": {"encoding": "utf8", "data": "hello"}
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1"},
        "result": {
          "items": [
            {
              "id": "log",
              "title": "log",
              "artist": "Lyrimuse Test Band",
              "lyrics": {"plain": "200\nhttps://lyrics.example/echo\nfalse\nhello"}
            }
          ]
        }
      }
    },
    {"include": "fragments/bye.json"}
  ]
}
