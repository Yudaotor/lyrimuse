{
  "id": "load-ok-search-and-getlyrics",
  "category": "load",
  "title": "加载成功:导出了 lyrics.search 和 lyrics.getLyrics",
  "subject": "both",
  "covers": ["plugin/load"],
  "fixture": {"manifest": "manifests/basic.json", "plugin": "plugins/relay.js"},
  "drive": [{"before": "initialize", "do": "start"}, {"before": "shutdown", "do": "stop"}],
  "steps": [
    {"include": "fragments/handshake.json"},
    {
      "label": "load",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "l1", "sample": 2},
        "method": "plugin/load",
        "params": {
          "manifest": {"$fixture": "manifest"},
          "source": {"mediaType": "text/javascript", "text": {"$fixture": "source"}}
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "l1"},
        "result": {"apiVersion": "0.1", "exports": {"$exact": {"lyrics": {"$unordered": ["search", "getLyrics"]}}}}
      }
    },
    {"include": "fragments/bye.json"}
  ]
}
