{
  "id": "malformed-missing-params-engine",
  "category": "malformed",
  "title": "plugin-host 的请求必填参数缺了或类型不对:-32602",
  "subject": "engine",
  "covers": ["host/fetch", "host/match", "host/storage.set"],
  "fixture": {"manifest": "manifests/basic.json", "plugin": "plugins/relay.js"},
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "playing"
    },
    {"before": "shutdown", "do": "stop"}
  ],
  "steps": [
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {
      "label": "search",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "Paper Lanterns",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "Paper Lanterns",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1", "sample": 1},
        "method": "host/fetch",
        "params": {"call": {"$var": "c1"}}
      },
      "invalid": "badParams"
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1"},
        "error": {"code": -32602, "message": {"$any": "string", "sample": "error"}}
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "m1", "sample": 2},
        "method": "host/match",
        "params": {"call": {"$var": "c1"}, "items": "all"}
      },
      "invalid": "badParams"
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "m1"},
        "error": {"code": -32602, "message": {"$any": "string", "sample": "error"}}
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "k1", "sample": 3},
        "method": "host/storage.set",
        "params": {"call": {"$var": "c1"}, "key": 7, "value": 1}
      },
      "invalid": "badParams"
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "k1"},
        "error": {"code": -32602, "message": {"$any": "string", "sample": "error"}}
      }
    },
    {"from": "host", "message": {"jsonrpc": "2.0", "id": {"$var": "s1"}, "result": {"items": []}}},
    {"include": "fragments/bye.json"}
  ]
}
