{
  "id": "cancel-deadline",
  "category": "cancel",
  "title": "任务截止到了:引擎发带 reason: deadline 的取消;plugin-host 回 -32800 或 -32801 都算数",
  "subject": "both",
  "covers": ["$/cancelRequest", "lyrics/search", "host/fetch"],
  "fixture": {
    "manifest": "manifests/basic.json",
    "plugin": "plugins/relay.js",
    "http": [
      {
        "request": {"method": "GET", "url": "https://lyrics.example/search?title=Paper%20Lanterns&artist=Lyrimuse%20Test%20Band"},
        "fail": "hang"
      }
    ]
  },
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "playing",
      "deadlineMs": 500
    },
    {"before": "shutdown", "do": "stop"}
  ],
  "steps": [
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {
      "label": "search",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 500}
          },
          "query": {
            "title": "Paper Lanterns",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "Paper Lanterns",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1", "sample": 1},
        "method": "host/fetch",
        "params": {
          "call": {"$var": "c1"},
          "request": {
            "url": "https://lyrics.example/search?title=Paper%20Lanterns&artist=Lyrimuse%20Test%20Band",
            "method": {"$optional": "GET"}
          }
        }
      }
    },
    {"clock": {"advanceMs": 500}},
    {
      "from": "engine",
      "unordered": [
        {"jsonrpc": "2.0", "method": "$/cancelRequest", "params": {"id": {"$var": "s1"}, "reason": "deadline"}},
        {
          "jsonrpc": "2.0",
          "id": {"$var": "f1"},
          "error": {"code": {"$oneOf": [-32801, -32800]}, "message": {"$any": "string", "sample": "error"}}
        }
      ]
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1"},
        "error": {"code": {"$oneOf": [-32800, -32801]}, "message": {"$any": "string", "sample": "error"}}
      }
    },
    {"observe": {"task": "t1", "outcome": {"status": "TIMEOUT"}}},
    {"include": "fragments/bye.json"}
  ]
}
