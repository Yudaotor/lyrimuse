{
  "id": "concurrency-in-flight-host-requests-limit",
  "category": "concurrency",
  "title": "plugin-host 同时在途的请求超过引擎握手时报的 maxInFlightHostRequests:多出来的回 -32802",
  "subject": "engine",
  "covers": ["host/fetch", "host/storage.keys"],
  "fixture": {
    "manifest": "manifests/basic.json",
    "plugin": "plugins/relay.js",
    "http": [
      {
        "request": {"method": "GET", "url": "https://lyrics.example/a"},
        "response": {"status": 200, "headers": [["content-type", "application/json"]], "body": "alpha"},
        "gate": "release"
      },
      {
        "request": {"method": "GET", "url": "https://lyrics.example/b"},
        "response": {"status": 200, "headers": [["content-type", "application/json"]], "body": "beta"},
        "gate": "release"
      }
    ],
    "config": {"engine": {"maxInFlightHostRequests": 2}}
  },
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "playing"
    },
    {"before": "release", "do": "releaseHttp", "gate": "release"},
    {"before": "shutdown", "do": "stop"}
  ],
  "steps": [
    {
      "label": "initialize",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "initId", "sample": 1},
        "method": "initialize",
        "params": {
          "protocolVersion": "0.1",
          "engineInfo": {"name": {"$any": "string", "sample": "lyrimuse-engine"}, "version": {"$any": "string", "sample": "1.15.0"}},
          "capabilities": {
            "host": {"fetch": {}, "match": {}, "storage": {}, "log": {}},
            "lyrics": {"wordFormats": {"$contains": ["timeline", "ttml", "lrc-a2"]}}
          },
          "limits": {
            "maxLineBytes": {"$any": "integer", "sample": 33554432},
            "maxResultBytes": {"$any": "integer", "sample": 8388608},
            "maxInFlightHostRequests": 2
          },
          "heartbeatIntervalMs": {"$any": "integer", "sample": 1000}
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "initId"},
        "result": {
          "protocolVersion": "0.1",
          "hostInfo": {
            "name": {"$any": "string", "sample": "lyrimuse-plugin-host"},
            "version": {"$any": "string", "sample": "1.15.0"},
            "runtime": {"$any": "string", "sample": "goja"},
            "sandbox": {"$any": "string", "sample": "seatbelt"}
          },
          "apiVersions": {"$contains": ["0.1"]},
          "capabilities": {"lyrics": {"search": {}, "getLyrics": {}}, "heartbeat": {}},
          "limits": {
            "maxLineBytes": {"$any": "integer", "sample": 33554432},
            "maxInFlightCalls": {"$any": "integer", "sample": 16}
          }
        }
      }
    },
    {"include": "fragments/load.json"},
    {
      "label": "search",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "Paper Lanterns",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "Paper Lanterns",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1", "sample": 1},
        "method": "host/fetch",
        "params": {"call": {"$var": "c1"}, "request": {"url": "https://lyrics.example/a", "method": {"$optional": "GET"}}}
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f2", "sample": 2},
        "method": "host/fetch",
        "params": {"call": {"$var": "c1"}, "request": {"url": "https://lyrics.example/b", "method": {"$optional": "GET"}}}
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "k1", "sample": 3},
        "method": "host/storage.keys",
        "params": {"call": {"$var": "c1"}}
      }
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "k1"},
        "error": {"code": -32802, "message": {"$any": "string", "sample": "error"}, "data": {"limit": "inFlightHostRequests"}}
      }
    },
    {
      "from": "engine",
      "unordered": [
        {
          "jsonrpc": "2.0",
          "id": {"$var": "f1"},
          "result": {
            "status": 200,
            "headers": {"$any": "array", "sample": [["content-type", "application/json"]]},
            "url": "https://lyrics.example/a",
            "redirected": false,
            "body": {"encoding": "utf8", "data": "alpha"}
          }
        },
        {
          "jsonrpc": "2.0",
          "id": {"$var": "f2"},
          "result": {
            "status": 200,
            "headers": {"$any": "array", "sample": [["content-type", "application/json"]]},
            "url": "https://lyrics.example/b",
            "redirected": false,
            "body": {"encoding": "utf8", "data": "beta"}
          }
        }
      ],
      "label": "release"
    },
    {"from": "host", "message": {"jsonrpc": "2.0", "id": {"$var": "s1"}, "result": {"items": []}}},
    {"include": "fragments/bye.json"}
  ]
}
