{
  "id": "fetch-cooldown-after-429",
  "category": "fetch",
  "title": "上游回 429 带 Retry-After:冷却记在这个插件头上,冷却期内它再发请求回 -32805 cooldown",
  "subject": "both",
  "covers": ["host/fetch"],
  "fixture": {
    "manifest": "manifests/basic.json",
    "plugin": "plugins/probe.js",
    "http": [
      {
        "request": {"method": "GET", "url": "https://lyrics.example/limited"},
        "response": {"status": 429, "headers": [["retry-after", "30"]], "body": ""}
      }
    ]
  },
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "retry-after-429", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "playing"
    },
    {"before": "shutdown", "do": "stop"}
  ],
  "steps": [
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {
      "label": "search",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "retry-after-429",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "retry-after-429",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "retry-after-429", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1", "sample": 1},
        "method": "host/fetch",
        "params": {"call": {"$var": "c1"}, "request": {"url": "https://lyrics.example/limited", "method": {"$optional": "GET"}}}
      }
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1"},
        "result": {
          "status": 429,
          "headers": {"$contains": [["retry-after", "30"]]},
          "url": "https://lyrics.example/limited",
          "redirected": false,
          "body": {"encoding": "utf8", "data": ""}
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f2", "sample": 2},
        "method": "host/fetch",
        "params": {"call": {"$var": "c1"}, "request": {"url": "https://lyrics.example/limited", "method": {"$optional": "GET"}}}
      }
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f2"},
        "error": {
          "code": -32805,
          "message": {"$any": "string", "sample": "error"},
          "data": {"reason": "cooldown", "retryAfterMs": {"$any": "integer", "sample": 30000}}
        }
      }
    },
    {"from": "host", "message": {"jsonrpc": "2.0", "id": {"$var": "s1"}, "result": {"items": []}}},
    {"observe": {"task": "t1", "outcome": {"status": "RATE_LIMITED", "retryAfter": 30}}},
    {"include": "fragments/bye.json"}
  ]
}
