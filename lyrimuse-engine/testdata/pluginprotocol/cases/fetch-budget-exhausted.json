{
  "id": "fetch-budget-exhausted",
  "category": "fetch",
  "title": "这个插件的后台小时额度用完了:再发请求回 -32805 budget,带多久之后再试",
  "subject": "engine",
  "covers": ["host/fetch"],
  "fixture": {
    "manifest": "manifests/basic.json",
    "plugin": "plugins/probe.js",
    "http": [
      {
        "request": {"method": "GET", "url": "https://lyrics.example/echo"},
        "response": {"status": 200, "headers": [["content-type", "application/json"]], "body": "hello"}
      }
    ],
    "config": {"engine": {"hourlyBudgetLeft": 1}}
  },
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "twice", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "background"
    },
    {"before": "shutdown", "do": "stop"}
  ],
  "steps": [
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {
      "label": "search",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "twice",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "twice",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "twice", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "background"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1", "sample": 1},
        "method": "host/fetch",
        "params": {"call": {"$var": "c1"}, "request": {"url": "https://lyrics.example/echo", "method": {"$optional": "GET"}}}
      }
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1"},
        "result": {
          "status": 200,
          "headers": {"$any": "array", "sample": [["content-type", "application/json"]]},
          "url": "https://lyrics.example/echo",
          "redirected": false,
          "body": {"encoding": "utf8", "data": "hello"}
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f2", "sample": 2},
        "method": "host/fetch",
        "params": {"call": {"$var": "c1"}, "request": {"url": "https://lyrics.example/echo", "method": {"$optional": "GET"}}}
      }
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f2"},
        "error": {
          "code": -32805,
          "message": {"$any": "string", "sample": "error"},
          "data": {"reason": "budget", "retryAfterMs": {"$any": "integer", "sample": 1800000}}
        }
      }
    },
    {"from": "host", "message": {"jsonrpc": "2.0", "id": {"$var": "s1"}, "result": {"items": []}}},
    {"observe": {"task": "t1", "outcome": {"status": "NOT_FOUND"}}},
    {"include": "fragments/bye.json"}
  ]
}
