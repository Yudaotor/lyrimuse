{
  "id": "lifecycle-shutdown-with-in-flight",
  "category": "lifecycle",
  "title": "关闭时还有调用在途:引擎把在途的 host/fetch 回成 -32800,plugin-host 先结掉调用再应答 shutdown",
  "subject": "both",
  "covers": ["shutdown", "lyrics/search", "host/fetch", "exit"],
  "fixture": {
    "manifest": "manifests/basic.json",
    "plugin": "plugins/relay.js",
    "http": [
      {
        "request": {"method": "GET", "url": "https://lyrics.example/search?title=Paper%20Lanterns&artist=Lyrimuse%20Test%20Band"},
        "fail": "hang"
      }
    ]
  },
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "playing"
    },
    {"before": "shutdown", "do": "stop"}
  ],
  "steps": [
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {
      "label": "search",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "Paper Lanterns",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "Paper Lanterns",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1", "sample": 1},
        "method": "host/fetch",
        "params": {
          "call": {"$var": "c1"},
          "request": {
            "url": "https://lyrics.example/search?title=Paper%20Lanterns&artist=Lyrimuse%20Test%20Band",
            "method": {"$optional": "GET"}
          }
        }
      }
    },
    {
      "from": "engine",
      "unordered": [
        {"jsonrpc": "2.0", "id": {"$var": "b1", "sample": 4}, "method": "shutdown"},
        {
          "jsonrpc": "2.0",
          "id": {"$var": "f1"},
          "error": {"code": -32800, "message": {"$any": "string", "sample": "error"}}
        }
      ],
      "label": "shutdown"
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1"},
        "error": {"code": -32800, "message": {"$any": "string", "sample": "error"}}
      }
    },
    {"from": "host", "message": {"jsonrpc": "2.0", "id": {"$var": "b1"}, "result": null}},
    {"from": "engine", "message": {"jsonrpc": "2.0", "method": "exit"}},
    {"from": "host", "close": true, "exitCode": 0}
  ]
}
