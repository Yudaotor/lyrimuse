{
  "id": "cancel-already-completed",
  "category": "cancel",
  "title": "取消一个已经应答过的请求:不应答、不出错",
  "subject": "host",
  "covers": ["$/cancelRequest", "lyrics/search"],
  "fixture": {"manifest": "manifests/basic.json", "plugin": "plugins/probe.js"},
  "steps": [
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "none",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "none",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "none", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1"},
        "result": {
          "items": [{"id": "none", "title": "none", "artist": "Lyrimuse Test Band", "lyrics": {"plain": "no requests"}}]
        }
      }
    },
    {"from": "engine", "message": {"jsonrpc": "2.0", "method": "$/cancelRequest", "params": {"id": {"$var": "s1"}}}},
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s2", "sample": 4},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c2", "sample": "c2"},
            "task": {"$var": "t2", "sample": "t2"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "none",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "none",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "none", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s2"},
        "result": {
          "items": [{"id": "none", "title": "none", "artist": "Lyrimuse Test Band", "lyrics": {"plain": "no requests"}}]
        }
      }
    },
    {"include": "fragments/bye.json"}
  ]
}
