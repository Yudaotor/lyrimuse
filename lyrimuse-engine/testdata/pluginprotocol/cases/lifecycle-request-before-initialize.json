{
  "id": "lifecycle-request-before-initialize",
  "category": "lifecycle",
  "title": "握手前发业务请求:-32806;之后照常握手",
  "subject": "host",
  "covers": ["initialize", "plugin/load", "lyrics/search", "shutdown"],
  "fixture": {"manifest": "manifests/basic.json", "plugin": "plugins/relay.js"},
  "steps": [
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "l0", "sample": 1},
        "method": "plugin/load",
        "params": {
          "manifest": {"$fixture": "manifest"},
          "source": {"mediaType": "text/javascript", "text": {"$fixture": "source"}}
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "l0"},
        "error": {"code": -32806, "message": {"$any": "string", "sample": "error"}, "data": {"state": "uninitialized"}}
      }
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s0", "sample": 2},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c0", "sample": "c0"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "Paper Lanterns",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "Paper Lanterns",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s0"},
        "error": {"code": -32806, "message": {"$any": "string", "sample": "error"}, "data": {"state": "uninitialized"}}
      }
    },
    {"from": "engine", "message": {"jsonrpc": "2.0", "id": {"$var": "b0", "sample": 3}, "method": "shutdown"}},
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "b0"},
        "error": {"code": -32806, "message": {"$any": "string", "sample": "error"}, "data": {"state": "uninitialized"}}
      }
    },
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {"include": "fragments/bye.json"}
  ]
}
