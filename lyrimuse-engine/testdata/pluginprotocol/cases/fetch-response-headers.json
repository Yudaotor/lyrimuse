{
  "id": "fetch-response-headers",
  "category": "fetch",
  "title": "应答头是名值对数组、名字小写,同名的多个值各占一项(Set-Cookie)",
  "subject": "both",
  "covers": ["host/fetch"],
  "fixture": {
    "manifest": "manifests/basic.json",
    "plugin": "plugins/probe.js",
    "http": [
      {
        "request": {"method": "GET", "url": "https://lyrics.example/cookies"},
        "response": {"status": 200, "headers": [["X-Fixture", "yes"], ["Set-Cookie", "a=1"], ["Set-Cookie", "b=2"]], "body": ""}
      }
    ]
  },
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "headers", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "playing"
    },
    {"before": "shutdown", "do": "stop"}
  ],
  "steps": [
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {
      "label": "search",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "headers",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "headers",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "headers", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1", "sample": 1},
        "method": "host/fetch",
        "params": {"call": {"$var": "c1"}, "request": {"url": "https://lyrics.example/cookies", "method": {"$optional": "GET"}}}
      }
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1"},
        "result": {
          "status": 200,
          "headers": {"$contains": [["x-fixture", "yes"], ["set-cookie", "a=1"], ["set-cookie", "b=2"]]},
          "url": "https://lyrics.example/cookies",
          "redirected": false,
          "body": {"encoding": "utf8", "data": ""}
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1"},
        "result": {
          "items": [{"id": "headers", "title": "headers", "artist": "Lyrimuse Test Band", "lyrics": {"plain": "yes\na=1|b=2"}}]
        }
      }
    },
    {"observe": {"task": "t1", "outcome": {"status": "FOUND"}}},
    {"include": "fragments/bye.json"}
  ]
}
