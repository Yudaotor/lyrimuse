{
  "id": "concurrency-two-tasks-interleaved",
  "category": "concurrency",
  "title": "两个任务同时在途:请求和应答交错,各自按 id 配对",
  "subject": "both",
  "covers": ["lyrics/search", "host/fetch"],
  "fixture": {
    "manifest": "manifests/basic.json",
    "plugin": "plugins/relay.js",
    "http": [
      {
        "request": {"method": "GET", "url": "https://lyrics.example/search?title=Paper%20Lanterns&artist=Lyrimuse%20Test%20Band"},
        "response": {
          "status": 200,
          "headers": [["content-type", "application/json"]],
          "body": "{\"items\":[{\"id\":\"101\",\"title\":\"Paper Lanterns\",\"artist\":\"Lyrimuse Test Band\",\"album\":\"Fixtures\",\"durationSecs\":215,\"lyrics\":{\"lines\":\"[00:01.00]Paper lanterns in the rain\\n[00:05.50]Drifting slowly down the lane\\n[00:10.25]Every light a small refrain\\n\"}}]}"
        }
      },
      {
        "request": {"method": "GET", "url": "https://lyrics.example/search?title=Second%20Song&artist=Lyrimuse%20Test%20Band"},
        "response": {"status": 200, "headers": [["content-type", "application/json"]], "body": "{\"items\":[]}"}
      }
    ]
  },
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search-a",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "playing"
    },
    {
      "before": "search-b",
      "do": "resolve",
      "task": "t2",
      "track": {"title": "Second Song", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "queue"
    },
    {"before": "shutdown", "do": "stop"}
  ],
  "steps": [
    {"include": "fragments/handshake.json"},
    {"include": "fragments/load.json"},
    {
      "label": "search-a",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "Paper Lanterns",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "Paper Lanterns",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "label": "search-b",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s2", "sample": 4},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c2", "sample": "c2"},
            "task": {"$var": "t2", "sample": "t2"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "Second Song",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "Second Song",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "Second Song", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "queue"
          }
        }
      }
    },
    {
      "from": "host",
      "unordered": [
        {
          "jsonrpc": "2.0",
          "id": {"$var": "f1", "sample": 1},
          "method": "host/fetch",
          "params": {
            "call": {"$var": "c1"},
            "request": {
              "url": "https://lyrics.example/search?title=Paper%20Lanterns&artist=Lyrimuse%20Test%20Band",
              "method": {"$optional": "GET"}
            }
          }
        },
        {
          "jsonrpc": "2.0",
          "id": {"$var": "f2", "sample": 2},
          "method": "host/fetch",
          "params": {
            "call": {"$var": "c2"},
            "request": {
              "url": "https://lyrics.example/search?title=Second%20Song&artist=Lyrimuse%20Test%20Band",
              "method": {"$optional": "GET"}
            }
          }
        }
      ]
    },
    {
      "from": "engine",
      "unordered": [
        {
          "jsonrpc": "2.0",
          "id": {"$var": "f2"},
          "result": {
            "status": 200,
            "headers": {"$any": "array", "sample": [["content-type", "application/json"]]},
            "url": "https://lyrics.example/search?title=Second%20Song&artist=Lyrimuse%20Test%20Band",
            "redirected": false,
            "body": {"encoding": "utf8", "data": "{\"items\":[]}"}
          }
        },
        {
          "jsonrpc": "2.0",
          "id": {"$var": "f1"},
          "result": {
            "status": 200,
            "headers": {"$any": "array", "sample": [["content-type", "application/json"]]},
            "url": "https://lyrics.example/search?title=Paper%20Lanterns&artist=Lyrimuse%20Test%20Band",
            "redirected": false,
            "body": {
              "encoding": "utf8",
              "data": "{\"items\":[{\"id\":\"101\",\"title\":\"Paper Lanterns\",\"artist\":\"Lyrimuse Test Band\",\"album\":\"Fixtures\",\"durationSecs\":215,\"lyrics\":{\"lines\":\"[00:01.00]Paper lanterns in the rain\\n[00:05.50]Drifting slowly down the lane\\n[00:10.25]Every light a small refrain\\n\"}}]}"
            }
          }
        }
      ]
    },
    {
      "from": "host",
      "unordered": [
        {"jsonrpc": "2.0", "id": {"$var": "s2"}, "result": {"items": []}},
        {
          "jsonrpc": "2.0",
          "id": {"$var": "s1"},
          "result": {
            "items": [
              {
                "id": "101",
                "title": "Paper Lanterns",
                "artist": "Lyrimuse Test Band",
                "album": "Fixtures",
                "durationSecs": 215,
                "lyrics": {
                  "lines": "[00:01.00]Paper lanterns in the rain\n[00:05.50]Drifting slowly down the lane\n[00:10.25]Every light a small refrain\n"
                }
              }
            ]
          }
        }
      ]
    },
    {"observe": {"task": "t1", "outcome": {"status": "FOUND"}}},
    {"observe": {"task": "t2", "outcome": {"status": "NOT_FOUND"}}},
    {"include": "fragments/bye.json"}
  ]
}
