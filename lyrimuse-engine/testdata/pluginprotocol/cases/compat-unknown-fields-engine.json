{
  "id": "compat-unknown-fields-engine",
  "category": "compat",
  "title": "结果和请求里出现不认识的字段:引擎一律忽略",
  "subject": "engine",
  "covers": ["initialize", "plugin/load", "lyrics/search", "host/fetch", "host/log"],
  "fixture": {
    "manifest": "manifests/basic.json",
    "plugin": "plugins/relay.js",
    "http": [
      {
        "request": {"method": "GET", "url": "https://lyrics.example/search?title=Paper%20Lanterns&artist=Lyrimuse%20Test%20Band"},
        "response": {"status": 200, "headers": [["content-type", "application/json"]], "body": "{\"items\":[]}"}
      }
    ]
  },
  "drive": [
    {"before": "initialize", "do": "start"},
    {
      "before": "search",
      "do": "resolve",
      "task": "t1",
      "track": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band", "album": "Fixtures", "durationSecs": 215},
      "round": "playing"
    },
    {"before": "shutdown", "do": "stop"}
  ],
  "ambient": [],
  "steps": [
    {
      "label": "initialize",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "initId", "sample": 1},
        "method": "initialize",
        "params": {
          "protocolVersion": "0.1",
          "engineInfo": {"name": {"$any": "string", "sample": "lyrimuse-engine"}, "version": {"$any": "string", "sample": "1.15.0"}},
          "capabilities": {
            "host": {"fetch": {}, "match": {}, "storage": {}, "log": {}},
            "lyrics": {"wordFormats": {"$contains": ["timeline", "ttml", "lrc-a2"]}}
          },
          "limits": {
            "maxLineBytes": {"$any": "integer", "sample": 33554432},
            "maxResultBytes": {"$any": "integer", "sample": 8388608},
            "maxInFlightHostRequests": {"$any": "integer", "sample": 64}
          },
          "heartbeatIntervalMs": {"$any": "integer", "sample": 1000}
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "initId"},
        "result": {
          "protocolVersion": "0.1",
          "hostInfo": {
            "name": {"$any": "string", "sample": "lyrimuse-plugin-host"},
            "version": {"$any": "string", "sample": "1.15.0"},
            "runtime": {"$any": "string", "sample": "goja"},
            "sandbox": {"$any": "string", "sample": "seatbelt"},
            "build": "abc123"
          },
          "apiVersions": {"$contains": ["0.1"]},
          "capabilities": {"lyrics": {"search": {}, "getLyrics": {}}, "heartbeat": {}, "future": {"x": 1}},
          "limits": {
            "maxLineBytes": {"$any": "integer", "sample": 33554432},
            "maxInFlightCalls": {"$any": "integer", "sample": 16}
          }
        }
      }
    },
    {
      "label": "load",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "loadId", "sample": 2},
        "method": "plugin/load",
        "params": {
          "manifest": {"$fixture": "manifest"},
          "source": {"mediaType": "text/javascript", "text": {"$fixture": "source"}}
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "loadId"},
        "result": {"apiVersion": "0.1", "exports": {"lyrics": ["search", "getLyrics"], "covers": ["get"]}, "futureField": 1}
      }
    },
    {
      "label": "search",
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1", "sample": 3},
        "method": "lyrics/search",
        "params": {
          "call": {
            "id": {"$var": "c1", "sample": "c1"},
            "task": {"$var": "t1", "sample": "t1"},
            "timeoutMs": {"$any": "integer", "sample": 20000}
          },
          "query": {
            "title": "Paper Lanterns",
            "artist": "Lyrimuse Test Band",
            "album": "Fixtures",
            "durationSecs": 215,
            "cleanTitle": "Paper Lanterns",
            "primaryArtist": "Lyrimuse Test Band",
            "artists": ["Lyrimuse Test Band"],
            "search": {"title": "Paper Lanterns", "artist": "Lyrimuse Test Band"},
            "attempt": {"index": 1, "count": 1, "variant": "primary"},
            "uiLanguage": {"$any": "string", "sample": "en"},
            "round": "playing"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "method": "host/log",
        "params": {"level": "trace", "message": "future level", "futureField": 1}
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1", "sample": 1},
        "method": "host/fetch",
        "params": {
          "call": {"$var": "c1"},
          "request": {
            "url": "https://lyrics.example/search?title=Paper%20Lanterns&artist=Lyrimuse%20Test%20Band",
            "priority": "high"
          },
          "futureField": 1
        }
      }
    },
    {
      "from": "engine",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "f1"},
        "result": {
          "status": 200,
          "headers": {"$any": "array", "sample": [["content-type", "application/json"]]},
          "url": "https://lyrics.example/search?title=Paper%20Lanterns&artist=Lyrimuse%20Test%20Band",
          "redirected": false,
          "body": {"encoding": "utf8", "data": "{\"items\":[]}"}
        }
      }
    },
    {
      "from": "host",
      "message": {
        "jsonrpc": "2.0",
        "id": {"$var": "s1"},
        "result": {
          "items": [
            {
              "id": "101",
              "title": "Paper Lanterns",
              "artist": "Lyrimuse Test Band",
              "album": "Fixtures",
              "durationSecs": 215,
              "futureField": 1,
              "lyrics": {
                "lines": "[00:01.00]Paper lanterns in the rain\n[00:05.50]Drifting slowly down the lane\n[00:10.25]Every light a small refrain\n",
                "futureTrack": {"x": 1}
              }
            }
          ],
          "nextCursor": "abc"
        }
      }
    },
    {"observe": {"task": "t1", "outcome": {"status": "FOUND"}}},
    {"include": "fragments/bye.json"}
  ]
}
